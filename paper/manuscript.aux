\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces SyncTrace pipeline. (a) Pseudo-forgery generator injects severity-controlled visual and audio degradations into authentic clips, emitting frame/pixel/spectral ground truth. (b) SyncEncoder fuses mel-spectrogram and video features through Mamba--Attention blocks with sparse frame selection. (c) CML organizes embeddings into a legitimate-synchronization manifold via severity-aware triplets and regresses manipulation severity. (d) SAE localizes the anomaly through GradCAM heatmaps, facial-region attributions, and audio band scores.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{7}{SyncTrace pipeline. (a) Pseudo-forgery generator injects severity-controlled visual and audio degradations into authentic clips, emitting frame/pixel/spectral ground truth. (b) SyncEncoder fuses mel-spectrogram and video features through Mamba--Attention blocks with sparse frame selection. (c) CML organizes embeddings into a legitimate-synchronization manifold via severity-aware triplets and regresses manipulation severity. (d) SAE localizes the anomaly through GradCAM heatmaps, facial-region attributions, and audio band scores}{figure.1}{}}
